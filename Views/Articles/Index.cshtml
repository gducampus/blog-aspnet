@model List<Article>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Articles";
}

<h1>Les articles du blog</h1>
@if (User.Identity?.IsAuthenticated == true)
{
    <p><a asp-action="Create" class="btn btn-primary">Nouvel article</a></p>
}

<form asp-action="Index" method="get" class="mb-4">
    <input name="recherche" value="@ViewBag.Recherche" placeholder="Rechercher un titre" class="form-control" />
</form>

@if (ViewBag.Tag != null)
{
    <p>Articles avec le tag <strong>@ViewBag.Tag</strong> · <a asp-action="Index">Tout afficher</a></p>
}

<div class="grille-articles">
    @foreach (var article in Model)
    {
        <partial name="_ArticleCarte" model="article" />
    }
</div>
